#%RAML 1.0
title: Ramlizer Test API
version: v1
baseUri: https://example.com
mediaType: application/json

types:
  Error:
    type: object
    properties:
      fieldName:
        type: string
        example: 'field'

/login:
  post:
    body:
      properties:
        loginId:
          type: string
          required: true
    responses:
      200:
        body:
          properties:
            response:
              enum:
                - success
      400:
        body:
          properties:
            errorList:
              type: Error[]
              required: true
          examples:
            badUsername:
              errorList:
                -
                  fieldName: userName
            badPassword:
              errorList:
                -
                  fieldName: password

/users/{userId}:
  get:
    responses:
      200:
        body:
          properties:
            id:
              type: string
