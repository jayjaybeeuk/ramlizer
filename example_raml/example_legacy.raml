#%RAML 0.8
title: Legacy Example
version: v0.8
schemas:
  - StatusSchema: |
      {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "uptime": { "type": "integer" }
        }
      }
/legacy/status:
  get:
    responses:
      200:
        body:
          application/json:
            schema: StatusSchema
            example: |
              {
                "status": "operational",
                "uptime": 86400
              }
